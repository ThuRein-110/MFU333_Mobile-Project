# Copy the Aiven PostgreSQL Service URI here, including /defaultdb.
# Both postgres:// and postgresql:// are supported; mysql:// also remains supported.
DATABASE_URL=
DB_SSL=true

# Paste the Aiven CA certificate as one line with literal \n between its lines.
DB_SSL_CA=
# Alternatively, point to a downloaded CA certificate for local SQL import.
DB_SSL_CA_FILE=

# Generated locally for this deployment; never include it in frontend builds.
JWT_SECRET=

# Linked Vercel Blob store credential. Vercel injects it on hosted deployments;
# `vercel env pull .env.local` supplies it for local image upload development.
BLOB_READ_WRITE_TOKEN=
